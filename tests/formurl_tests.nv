// formurl_tests.nv — the WHATWG `application/x-www-form-urlencoded`
// parser and serialiser, and the scanner under them.
//
// The parser vectors are the web-platform-tests file
// `url/urlencoded-parser.any.js`, less the ones whose answer holds
// U+FFFD: the standard replaces an invalid UTF-8 sequence and this
// package answers the bytes as sent.

use std.test
use std.list
use std.str
use std.bytes
use formscan
use formurl
use formerr

fn parsed(src: Str) -> formurl.FormBody
    formurl.parse(bytes.from_str(src))

// Every pair of a body as `name=value`, decoded, joined with `|`.
fn pairs_of(src: Str) -> Str
    let b = parsed(src)
    var out: [Str] = []
    for p in b.pairs
        list.push(out, formurl.key_str(b, p) + "=" + formurl.value_str(b, p))
    str.join(out, "|")

@test
fn test_the_web_platform_tests_parser_vectors() [io]
    test.case("an empty body, and separators alone, have no pairs")
    test.assert(pairs_of("") == "")
    test.assert(pairs_of("&") == "")

    test.case("a name with no `=` has an empty value")
    test.assert(pairs_of("test") == "test=")
    test.assert(pairs_of("a") == "a=")
    test.assert(pairs_of("a=") == "a=")
    test.assert(pairs_of("=b") == "=b")
    test.assert(pairs_of("a=b") == "a=b")

    test.case("empty fields are skipped")
    test.assert(pairs_of("&a") == "a=")
    test.assert(pairs_of("a&") == "a=")
    test.assert(pairs_of("a&a") == "a=|a=")
    test.assert(pairs_of("a&b&c") == "a=|b=|c=")
    test.assert(pairs_of("a=b&c=d") == "a=b|c=d")
    test.assert(pairs_of("a=b&c=d&") == "a=b|c=d")
    test.assert(pairs_of("&&&a=b&&&&c=d&") == "a=b|c=d")
    test.assert(pairs_of("a=a&a=b&a=c") == "a=a|a=b|a=c")

    test.case("only the first `=` separates")
    test.assert(pairs_of("a==a") == "a==a")

    test.case("`+` is a space and `%XX` is a byte, in either case")
    test.assert(pairs_of("a=a+b+c+d") == "a=a b c d")
    test.assert(pairs_of("%61=a") == "a=a")
    test.assert(pairs_of("%61+%4d%4D=") == "a MM=")

    test.case("a `%` that begins no escape is kept")
    test.assert(pairs_of("%=a") == "%=a")
    test.assert(pairs_of("%a=a") == "%a=a")
    test.assert(pairs_of("%a_=a") == "%a_=a")
    test.assert(pairs_of("id=0&value=%") == "id=0|value=%")
    test.assert(pairs_of("b=%2sf%2a") == "b=%2sf*")
    test.assert(pairs_of("b=%2%2af%2a") == "b=%2*f*")
    test.assert(pairs_of("b=%%2a") == "b=%*")

    test.case("UTF-8 passes through, escaped or not")
    test.assert(pairs_of("%EF%BB%BFtest=%EF%BB%BF") == "\u{FEFF}test=\u{FEFF}")
    test.assert(pairs_of("\u{FEFF}test=\u{FEFF}") == "\u{FEFF}test=\u{FEFF}")
    test.assert(pairs_of("%EF%BF%BF=%EF%BF%BF") == "\u{FFFF}=\u{FFFF}")
    test.assert(pairs_of("†&†=x") == "†=|†=x")

@test
fn test_a_repeated_name_is_a_list() [io]
    let b = parsed("tag=a&tag=b&name=ada")

    test.case("three fields, two of them one name")
    test.assert(list.len(b.pairs) == 3)

    test.case("get answers the first and get_all answers both, in order")
    test.assert(formurl.get(b, "tag") == Some("a"))
    let all = formurl.get_all(b, "tag")
    test.assert(list.len(all) == 2)
    test.assert(all[1] == "b")

    test.case("count and keys")
    test.assert(formurl.count(b, "tag") == 2)
    test.assert(formurl.count(b, "absent") == 0)
    let ks = formurl.keys(b)
    test.assert(list.len(ks) == 2)
    test.assert(ks[0] == "tag")
    test.assert(ks[1] == "name")

@test
fn test_a_field_with_no_value_is_present_and_empty() [io]
    let b = parsed("name=&tick&other=x")

    test.case("an empty value and a bare name both answer the empty string")
    test.assert(formurl.get(b, "name") == Some(""))
    test.assert(formurl.get(b, "tick") == Some(""))
    test.assert(formurl.has(b, "tick"))

    test.case("the pair says which of the two it was")
    test.assert(b.pairs[0].had_assigner)
    test.assert(not b.pairs[1].had_assigner)

    test.case("an absent name is absent")
    test.assert(not formurl.has(b, "nothing"))
    test.assert(formurl.get(b, "nothing") == None)

@test
fn test_a_bound_on_the_field_count() [io]
    test.case("a bad escape is flagged, and a clean body is not")
    test.assert(parsed("a=100%&b=%zz").had_bad_escape)
    test.assert(not parsed("a=100").had_bad_escape)

    test.case("more fields than the bound are refused")
    match formurl.parse_bounded(bytes.from_str("a=1&b=2&c=3"), 2)
        Ok(_)  => test.assert(false)
        Err(e) =>
            test.assert(formerr.is_limit(e))
            match e
                FormTooManyPairs(n) => test.assert(n == 2)
                _                   => test.assert(false)

    test.case("and a body within it is read")
    match formurl.parse_bounded(bytes.from_str("a=1&b=2"), 2)
        Err(_) => test.assert(false)
        Ok(x)  => test.assert(list.len(x.pairs) == 2)

@test
fn test_decoding_is_one_call() [io]
    test.case("`+`, `%20` and `%2F` in either case")
    test.assert(formurl.decode("ada+lovelace") == "ada lovelace")
    test.assert(formurl.decode("ada%20lovelace") == "ada lovelace")
    test.assert(formurl.decode("a%2Fb") == "a/b")
    test.assert(formurl.decode("a%2fb") == "a/b")

    test.case("`&` and `=` are ordinary bytes to decode")
    test.assert(formurl.decode("a=b&c") == "a=b&c")

    test.case("a truncated escape is kept")
    test.assert(formurl.decode("50%") == "50%")
    test.assert(formurl.decode("50%4") == "50%4")

@test
fn test_a_pair_is_spans_and_is_decoded_on_request() [io]
    let b = parsed("name=ada&city=london&z=%00x")

    test.case("the spans index the body")
    test.assert(b.pairs[0].key.start == 0)
    test.assert(b.pairs[0].key.end == 4)
    test.assert(b.pairs[0].value.start == 5)
    test.assert(b.pairs[0].value.end == 8)

    test.case("the decode is a call")
    test.assert(formurl.key_str(b, b.pairs[0]) == "name")
    test.assert(formurl.value_str(b, b.pairs[0]) == "ada")

    test.case("a value's bytes hold what a `Str` cannot")
    test.assert(bytes.to_str(formurl.value_bytes(b, b.pairs[1])) == "london")
    test.assert(bytes.to_hex(formurl.value_bytes(b, b.pairs[2])) == "0078")

    test.case("a span's encoded bytes, and its decoded length without a decode")
    test.assert(bytes.len(formurl.span_bytes(b, b.pairs[0].key)) == 4)
    test.assert(formurl.decoded_len(b, b.pairs[0].value) == 3)
    let esc = parsed("a=x%2Fy%")
    test.assert(formurl.decoded_len(esc, esc.pairs[0].value) == 4)

@test
fn test_the_serialiser_is_the_whatwg_one() [io]
    test.case("a space becomes `+`, `&` an escape, and hex is upper case")
    test.assert(formurl.serialise([("q", "a b")]) == "q=a+b")
    test.assert(formurl.serialise([("n", "1&2")]) == "n=1%262")
    test.assert(formurl.encode("a/b") == "a%2Fb")

    test.case("`~` is encoded, where urllib leaves it")
    test.assert(formurl.encode("~") == "%7E")
    test.assert(not formurl.is_safe("~"))

    test.case("the safe set is letters, digits, `*`, `-`, `.` and `_`")
    test.assert(formurl.is_safe("aZ0*-._"))
    test.assert(formurl.encode("aZ0*-._") == "aZ0*-._")

    test.case("no pairs is the empty string")
    test.assert(formurl.serialise([]) == "")
    test.assert(formurl.serialised_len([]) == 0)

@test
fn test_serialise_round_trips_through_parse() [io]
    let pairs = [("q", "a b"), ("n", "1&2"), ("empty", ""), ("uni", "café")]
    let text = formurl.serialise(pairs)
    let b = formurl.parse_str(text)

    test.case("every pair survives")
    test.assert(text == "q=a+b&n=1%262&empty=&uni=caf%C3%A9")
    test.assert(list.len(b.pairs) == 4)
    test.assert(formurl.get(b, "n") == Some("1&2"))
    test.assert(formurl.get(b, "uni") == Some("café"))

    test.case("the length is known before the write")
    test.assert(formurl.serialised_len(pairs) == str.len(text))

    test.case("the buffer form writes the same bytes at an offset")
    var buf = bytes.zeros(formurl.serialised_len(pairs) + 2)
    formurl.serialise_into(buf, 1, pairs)
    test.assert(bytes.to_str(bytes.slice(buf, 1, 1 + str.len(text))) == text)
    test.assert(bytes.byte_at(buf, 0) == Some(0))

@test
fn test_the_host_half_and_the_device_half_are_one_walk() [io]
    let body = bytes.from_str("a=1&b=2")

    test.case("the scan agrees with the parse")
    test.assert(formscan.scan_fields(formurl.scan_all(body)) == 2)
    test.assert(list.len(formurl.parse(body).pairs) == 2)

    test.case("a device drives the same scanner a byte at a time")
    var d = formscan.scan()
    for c in [97, 61, 49, 38, 98, 61, 50]
        d = formscan.scan_byte(d, c)
    d = formscan.scan_end(d)
    test.assert(formscan.scan_fields(d) == 2)
    test.assert(formscan.scan_field_done(d))

    test.case("an empty field closes without counting")
    var e = formscan.scan_byte(formscan.scan(), '&')
    test.assert(not formscan.scan_field_done(e))
    test.assert(formscan.scan_field_start(e) == 1)
    e = formscan.scan_end(e)
    test.assert(formscan.scan_fields(e) == 0)

@test
fn test_the_scanner_decodes_as_it_walks() [io]
    test.case("`+` answers a space on the step that fed it")
    let p = formscan.scan_byte(formscan.scan(), '+')
    test.assert(formscan.scan_emitted(p))
    test.assert(formscan.scan_out(p) == 32)
    test.assert(formscan.scan_out_count(p) == 1)

    test.case("an escape answers its byte on the step that fed the last digit")
    var e = formscan.scan_byte(formscan.scan(), '%')
    test.assert(formscan.scan_in_escape(e))
    test.assert(not formscan.scan_emitted(e))
    test.assert(formscan.scan_out(e) == -1)
    e = formscan.scan_byte(e, '2')
    test.assert(formscan.scan_in_escape(e))
    e = formscan.scan_byte(e, 'F')
    test.assert(formscan.scan_out(e) == 47)
    test.assert(not formscan.scan_in_escape(e))

    test.case("a `%` that begins no escape comes out with the byte that showed it")
    var bad = formscan.scan_byte(formscan.scan(), '%')
    bad = formscan.scan_byte(bad, 'z')
    test.assert(formscan.scan_bad_escape(bad))
    test.assert(formscan.scan_out_count(bad) == 2)
    test.assert(formscan.scan_out_at(bad, 0) == '%')
    test.assert(formscan.scan_out_at(bad, 1) == 'z')
    test.assert(formscan.scan_out_at(bad, 2) == -1)
    test.assert(formscan.scan_out_at(bad, -1) == -1)

    test.case("after one digit, three bytes come out")
    var two = formscan.scan_byte(formscan.scan(), '%')
    two = formscan.scan_byte(two, '4')
    two = formscan.scan_byte(two, 'g')
    test.assert(formscan.scan_out_count(two) == 3)
    test.assert(formscan.scan_out_at(two, 1) == '4')
    test.assert(formscan.scan_out_at(two, 2) == 'g')

    test.case("a `%` before `=` belongs to the name, and before `&` to its field")
    var k = formscan.scan_byte(formscan.scan(), '%')
    k = formscan.scan_byte(k, '=')
    test.assert(formscan.scan_key_done(k))
    test.assert(formscan.scan_in_key(k))
    test.assert(formscan.scan_out(k) == '%')
    var f = formscan.scan_byte(formscan.scan(), '%')
    f = formscan.scan_byte(f, '&')
    test.assert(formscan.scan_field_done(f))
    test.assert(formscan.scan_out(f) == '%')

    test.case("a truncated escape at the end is flagged and kept")
    var cut = formscan.scan_byte(formscan.scan(), '%')
    cut = formscan.scan_end(cut)
    test.assert(formscan.scan_bad_escape(cut))
    test.assert(formscan.scan_out(cut) == '%')
    var cut2 = formscan.scan_byte(formscan.scan(), '%')
    cut2 = formscan.scan_byte(cut2, 'a')
    cut2 = formscan.scan_end(cut2)
    test.assert(formscan.scan_out_count(cut2) == 2)
    test.assert(formscan.scan_fields(cut2) == 1)

@test
fn test_the_scanner_says_which_side_of_the_equals_a_byte_is_on() [io]
    var s = formscan.scan_byte(formscan.scan(), 'a')

    test.case("before the `=`, the byte is in the name")
    test.assert(formscan.scan_in_key(s))
    test.assert(not formscan.scan_has_value(s))

    s = formscan.scan_byte(s, '=')
    test.case("the `=` ends it")
    test.assert(formscan.scan_key_done(s))
    test.assert(formscan.scan_has_value(s))

    s = formscan.scan_byte(s, '=')
    test.case("a second `=` is a value byte")
    test.assert(not formscan.scan_key_done(s))
    test.assert(formscan.scan_out(s) == '=')
    test.assert(not formscan.scan_in_key(s))

    s = formscan.scan_byte(s, '&')
    test.case("the `&` closes the field")
    test.assert(formscan.scan_field_done(s))
    test.assert(formscan.scan_fields(s) == 1)
    test.assert(formscan.scan_field_start(s) == formscan.scan_pos(s))
    test.assert(formscan.scan_pos(s) == 4)

@test
fn test_the_byte_arithmetic() [io]
    test.case("the separators")
    test.assert(formscan.separator() == '&')
    test.assert(formscan.assigner() == '=')
    test.assert(formscan.plus_means() == ' ')

    test.case("hex both ways")
    test.assert(formscan.hex_value('0') == 0)
    test.assert(formscan.hex_value('F') == 15)
    test.assert(formscan.hex_value('f') == 15)
    test.assert(formscan.hex_value('g') == -1)
    test.assert(formscan.hex_digit(9) == '9')
    test.assert(formscan.hex_digit(15) == 'F')

    test.case("the safe set and the width a byte encodes to")
    test.assert(formscan.byte_safe('a'))
    test.assert(formscan.byte_safe('*'))
    test.assert(not formscan.byte_safe('~'))
    test.assert(not formscan.byte_safe('&'))
    test.assert(formscan.encoded_len('a') == 1)
    test.assert(formscan.encoded_len(' ') == 1)
    test.assert(formscan.encoded_len('&') == 3)
