// embedded_probe.nv — a firmware image that walks an urlencoded body
// with `formscan` on a Cortex-M4.
//
// It is not a test.  `scripts/shard_audit.sh` copies it with `formscan`
// into a package of its own and builds it with
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a Cortex-M4 ELF or fails.
//
// Only `formscan` is claimed.  `formurl`, `formpart`, `formfield` and
// `formerr` name `Bytes` or `Str`, which the embedded runtime does not
// define, and one host-only function in a compilation unit is an
// undefined symbol at link time.  The probe feeds bytes as integers and
// reads decoded bytes and field boundaries back as integers.

use formscan

// Feed bodies byte by byte and count the answers that are right, so a
// single comparison decides the run.
@tier(rt)
fn score() -> Int
    var n = 0
    if formscan.separator() == 38
        n = n + 1
    if formscan.assigner() == 61
        n = n + 1
    if formscan.plus_means() == 32
        n = n + 1
    // `a=1&b=2`, one byte at a time.
    var s = formscan.scan()
    if formscan.scan_pos(s) == 0
        n = n + 1
    s = formscan.scan_byte(s, 97)
    if formscan.scan_in_key(s)
        n = n + 1
    s = formscan.scan_byte(s, 61)
    if formscan.scan_key_done(s)
        n = n + 1
    s = formscan.scan_byte(s, 49)
    if formscan.scan_emitted(s)
        n = n + 1
    if formscan.scan_out(s) == 49
        n = n + 1
    s = formscan.scan_byte(s, 38)
    if formscan.scan_field_done(s)
        n = n + 1
    s = formscan.scan_byte(s, 98)
    s = formscan.scan_byte(s, 61)
    s = formscan.scan_byte(s, 50)
    s = formscan.scan_end(s)
    if formscan.scan_fields(s) == 2
        n = n + 1
    // `+` and an escape decode as they are fed.
    var p = formscan.scan_byte(formscan.scan(), 43)
    if formscan.scan_out(p) == 32
        n = n + 1
    var e = formscan.scan()
    e = formscan.scan_byte(e, 37)
    e = formscan.scan_byte(e, 50)
    if formscan.scan_in_escape(e)
        n = n + 1
    e = formscan.scan_byte(e, 70)
    if formscan.scan_out(e) == 47
        n = n + 1
    // The byte arithmetic a device uses to size its own buffers.
    if formscan.hex_value(70) == 15
        n = n + 1
    if formscan.hex_value(102) == 15
        n = n + 1
    if formscan.hex_digit(15) == 70
        n = n + 1
    if formscan.byte_safe(97)
        n = n + 1
    if formscan.byte_safe(126) == false
        n = n + 1
    if formscan.encoded_len(97) == 1
        n = n + 1
    if formscan.encoded_len(47) == 3
        n = n + 1
    n

@tier(rt)
fn main() [hw, time]
    bsp.board.init()
    // 20 is the number of checks in `score`.
    let n = score()
    if n == 20
        hal.uart.write("PASS: form-embedded\n")
    else
        hal.uart.write("FAIL: form-embedded\n")
    loop
        core.rt.sleep_ms(1000)
