// formfield.nv — a form field as the type a handler wanted, or a
// refusal that names the field.
//
// Every refusal here carries the field's name, so the 400 a handler
// answers can say which field is wrong and what was expected.  `check`
// takes a list of expectations and answers every one the body fails,
// so a form with six bad fields reports six.
//
// A form has one shape for a list: a repeated name, `tag=a&tag=b`.
// Some frameworks also read `tag[]=a` as a list and `user[name]=ada` as
// a nested object.  That convention is in no standard and the
// frameworks disagree about it, so `bracket_names` reports the names
// that use it and the caller decides what they mean.

use std.list
use std.str
use formurl
use formerr

// What a field is expected to be.
pub struct FormExpect
    name: Str
    kind: FormKind
    // Whether the field must be present.  A missing optional field is
    // not a finding.
    required: Bool
    // For an integer: the inclusive bounds.  `min > max` means
    // unbounded.
    min: Int
    max: Int
    // For a string: the largest length in bytes, or -1 for unbounded.
    max_len: Int

// What a field is read as.
pub enum FormKind
    FormKindStr
    FormKindInt
    FormKindBool
    FormKindFloat
    // A repeated name, read as every one of its values.
    FormKindList

// ── One field at a time ──────────────────────────────────────────────

// A field as a string, or `FormMissing` naming it.
//
// ```novo
// use formfield
// use formurl
// use std.bytes
//
// fn main() [io]
//     let b = formurl.parse(bytes.from_str("name=ada"))
//     match formfield.get_str(b, "name")
//         Ok(v)  => println(v)
//         Err(_) => println("missing")
// ```
pub fn get_str(b: formurl.FormBody, name: Str) -> Result<Str, formerr.FormError> []
    match formurl.get(b, name)
        Some(v) => Ok(v)
        None    => Err(FormMissing(name))

// A field as an integer: an optional `+` or `-` and one or more
// decimal digits, and nothing else.
//
// A value that does not read, or does not fit in an `Int`, is
// `FormNotAnInt` with the text that arrived.
pub fn get_int(b: formurl.FormBody, name: Str) -> Result<Int, formerr.FormError> []
    let text = get_str(b, name)!
    int_of(name, text)

// A field as an integer within inclusive bounds.
//
// A value that is not an integer is `FormNotAnInt`, and one outside the
// bounds is `FormOutOfRange` carrying both of them.
pub fn get_int_between(b: formurl.FormBody, name: Str, min: Int,
                       max: Int) -> Result<Int, formerr.FormError> []
    let text = get_str(b, name)!
    let n = int_of(name, text)!
    if n < min or n > max
        return Err(FormOutOfRange(name, text, min, max))
    Ok(n)

// A field as a boolean, by the spellings a web form sends.
//
// True: `on`, `true`, `yes` and `1`.  False: `off`, `false`, `no`, `0`
// and the empty string.  Case is ignored.  Anything else is
// `FormNotABool`.  An absent field is `FormMissing`, not `false`,
// because a yes-or-no select is a field that must be answered;
// `checkbox` is the call where absence means false.
pub fn get_bool(b: formurl.FormBody, name: Str) -> Result<Bool, formerr.FormError> []
    let text = get_str(b, name)!
    let t = str.lower(text)
    if t == "on" or t == "true" or t == "yes" or t == "1"
        return Ok(true)
    if t == "off" or t == "false" or t == "no" or t == "0" or t == ""
        return Ok(false)
    Err(FormNotABool(name, text))

// A checkbox: `true` when the field is present with a true spelling of
// `get_bool`, and `false` otherwise.
//
// An HTML checkbox sends `on` when it is ticked and nothing when it is
// not.
pub fn checkbox(b: formurl.FormBody, name: Str) -> Bool []
    match get_bool(b, name)
        Ok(v)  => v
        Err(_) => false

// A field as a number: an optional sign, digits with an optional
// fraction, and an optional exponent, which is what
// `<input type="number">` sends.
//
// `NaN`, `Infinity` and any other spelling are `FormNotAFloat`.
pub fn get_float(b: formurl.FormBody, name: Str) -> Result<Float, formerr.FormError> []
    let text = get_str(b, name)!
    let f = if float_text(text)
        str.to_float(text)
    else
        None
    match f
        Some(v) => Ok(v)
        None    => Err(FormNotAFloat(name, text))

// Every value of a repeated name, in order.  An absent name answers an
// empty list.
pub fn get_list(b: formurl.FormBody, name: Str) -> [Str] []
    formurl.get_all(b, name)

// Every value of a repeated name, or `FormEmptyList` when there is
// none.
pub fn get_list_required(b: formurl.FormBody, name: Str) -> Result<[Str], formerr.FormError> []
    let vs = formurl.get_all(b, name)
    if list.len(vs) == 0
        return Err(FormEmptyList(name))
    Ok(vs)

// Every value of a repeated name, as integers.
//
// One value that is not an integer refuses the list, naming the field
// and the value.
pub fn get_int_list(b: formurl.FormBody, name: Str) -> Result<[Int], formerr.FormError> []
    var out: [Int] = []
    for v in formurl.get_all(b, name)
        list.push(out, int_of(name, v)!)
    Ok(out)

// A field as a string, or `fallback` when it is absent or empty.
pub fn get_or(b: formurl.FormBody, name: Str, fallback: Str) -> Str []
    let v = formurl.get(b, name) ?? ""
    if v == ""
        return fallback
    v

// A field as a string, refusing one longer than `max_len` bytes with
// `FormTooLong`.
pub fn get_str_bounded(b: formurl.FormBody, name: Str,
                       max_len: Int) -> Result<Str, formerr.FormError> []
    let v = get_str(b, name)!
    if str.len(v) > max_len
        return Err(FormTooLong(name, str.len(v), max_len))
    Ok(v)

// A field whose value must be one of `allowed`, refusing any other
// with `FormNotAllowed`.
pub fn get_one_of(b: formurl.FormBody, name: Str,
                  allowed: [Str]) -> Result<Str, formerr.FormError> []
    let v = get_str(b, name)!
    if list.contains(allowed, v)
        return Ok(v)
    Err(FormNotAllowed(name, v))

// ── A whole form at once ─────────────────────────────────────────────

// A required string field of any length.
pub fn expect_str(name: Str) -> FormExpect []
    FormExpect { name: name, kind: FormKindStr, required: true, min: 1, max: 0, max_len: 0 - 1 }

// A required integer field, unbounded.
pub fn expect_int(name: Str) -> FormExpect []
    FormExpect { name: name, kind: FormKindInt, required: true, min: 1, max: 0, max_len: 0 - 1 }

// A required integer field within inclusive bounds.
pub fn expect_int_between(name: Str, min: Int, max: Int) -> FormExpect []
    FormExpect { name: name, kind: FormKindInt, required: true, min: min, max: max, max_len: 0 - 1 }

// A required boolean field.
pub fn expect_bool(name: Str) -> FormExpect []
    FormExpect { name: name, kind: FormKindBool, required: true, min: 1, max: 0, max_len: 0 - 1 }

// The same expectation, made optional.
pub fn optional(e: FormExpect) -> FormExpect []
    FormExpect { name: e.name, kind: e.kind, required: false, min: e.min, max: e.max,
                 max_len: e.max_len }

// Every expectation a body fails, in the order the expectations are
// given.
//
// A missing required field is `FormMissing`; a missing optional field
// is not a finding.  A present field is read by its kind: a string
// against `max_len`, an integer against its bounds when `min <= max`, a
// boolean by `get_bool`'s spellings, a number by `get_float`'s, and a
// required list must have a value.  An empty list means the body meets
// every expectation.
//
// ```novo
// use formfield
// use formurl
// use std.bytes
// use std.list
//
// fn main() [io]
//     let b = formurl.parse(bytes.from_str("age=old"))
//     let bad = formfield.check(b, [formfield.expect_int("age"),
//                                   formfield.expect_str("name")])
//     println("${list.len(bad)}")
// ```
pub fn check(b: formurl.FormBody, expects: [FormExpect]) -> [formerr.FormError] []
    var out: [formerr.FormError] = []
    for e in expects
        match check_one(b, e)
            Some(err) => list.push(out, err)
            None      => ()
    out

// Whether a body meets every expectation.
pub fn is_valid(b: formurl.FormBody, expects: [FormExpect]) -> Bool []
    list.len(check(b, expects)) == 0

// The names a body carries that no expectation names, each once, in
// the order first seen.
//
// A form may carry a CSRF token or a submit button's name, so these are
// reported rather than refused.
pub fn unexpected_keys(b: formurl.FormBody, expects: [FormExpect]) -> [Str] []
    var named: [Str] = []
    for e in expects
        list.push(named, e.name)
    var out: [Str] = []
    for k in formurl.keys(b)
        if not list.contains(named, k)
            list.push(out, k)
    out

// ── The bracket convention, reported ─────────────────────────────────

// The names of a body that use the `name[]` or `name[key]` convention:
// a `[` after at least one byte, and a final `]`.  Each once, in the
// order first seen.
pub fn bracket_names(b: formurl.FormBody) -> [Str] []
    var out: [Str] = []
    for k in formurl.keys(b)
        let open = str.index(k, "[") ?? 0
        if open > 0 and str.ends_with(k, "]")
            list.push(out, k)
    out

// A bracketed name's base: `tag[]` is `tag`, `user[name]` is `user`,
// and a name with no `[` is itself.
pub fn bracket_base(key: Str) -> Str []
    match str.index(key, "[")
        Some(i) => str.slice(key, 0, i)
        None    => key

// ── Helpers ──────────────────────────────────────────────────────────

// A value read as an integer, or `FormNotAnInt`.
fn int_of(name: Str, text: Str) -> Result<Int, formerr.FormError>
    var from = 0
    let first = str.byte_at_or(text, 0, 0)
    if first == '+' or first == '-'
        from = 1
    if not digits(text, from, str.len(text))
        return Err(FormNotAnInt(name, text))
    var body = text
    if first == '+'
        body = str.slice(text, 1, str.len(text))
    match str.to_int(body)
        Some(n) => Ok(n)
        None    => Err(FormNotAnInt(name, text))

// Whether `s[from:to]` is one or more decimal digits.
fn digits(s: Str, from: Int, to: Int) -> Bool
    if from >= to
        return false
    for i in from..to
        let b = str.byte_at_or(s, i, 0)
        if b < '0' or b > '9'
            return false
    true

// How many decimal digits stand at `i`.
fn digit_run(s: Str, i: Int) -> Int
    var k = i
    for j in i..str.len(s)
        let b = str.byte_at_or(s, j, 0)
        if b < '0' or b > '9'
            break
        k = j + 1
    k - i

// Whether a value is a number in the grammar `get_float` reads.
fn float_text(t: Str) -> Bool
    var i = 0
    let first = str.byte_at_or(t, 0, 0)
    if first == '+' or first == '-'
        i = 1
    let whole = digit_run(t, i)
    i = i + whole
    var frac = 0
    if str.byte_at_or(t, i, 0) == '.'
        frac = digit_run(t, i + 1)
        i = i + 1 + frac
    if whole + frac == 0
        return false
    let e = str.byte_at_or(t, i, 0)
    if e == 'e' or e == 'E'
        i = i + 1
        let sign = str.byte_at_or(t, i, 0)
        if sign == '+' or sign == '-'
            i = i + 1
        let exp = digit_run(t, i)
        if exp == 0
            return false
        i = i + exp
    i == str.len(t)

// The first way a body fails one expectation, or `None`.
fn check_one(b: formurl.FormBody, e: FormExpect) -> ?formerr.FormError
    if not formurl.has(b, e.name)
        if e.required
            return Some(FormMissing(e.name))
        return None
    match e.kind
        FormKindStr   => refusal_of(get_str_bounded(b, e.name, bound_of(e)))
        FormKindInt   => refusal_of(read_int(b, e))
        FormKindBool  => refusal_of(get_bool(b, e.name))
        FormKindFloat => refusal_of(get_float(b, e.name))
        FormKindList  => None

// A read's refusal, or `None` when the read succeeded.
fn refusal_of<T>(r: Result<T, formerr.FormError>) -> ?formerr.FormError
    match r
        Ok(_)  => None
        Err(x) => Some(x)

// An integer expectation's read: bounded when `min <= max`.
fn read_int(b: formurl.FormBody, e: FormExpect) -> Result<Int, formerr.FormError>
    if e.min <= e.max
        return get_int_between(b, e.name, e.min, e.max)
    get_int(b, e.name)

// A string expectation's length bound, with -1 read as no bound.
fn bound_of(e: FormExpect) -> Int
    if e.max_len < 0
        return 9223372036854775807
    e.max_len
