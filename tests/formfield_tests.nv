// formfield_tests.nv — typed reads whose refusals name the field, and
// the boolean spellings a web form sends.

use std.test
use std.list
use std.str
use std.bytes
use formurl
use formfield
use formerr

fn parsed(src: Str) -> formurl.FormBody
    formurl.parse(bytes.from_str(src))

// A read's answer as text: the value, or `err` and the field it names.
fn int_of(r: Result<Int, formerr.FormError>) -> Str
    match r
        Ok(n)  => "${n}"
        Err(e) => "err " + formerr.error_field(e)

fn bool_of(r: Result<Bool, formerr.FormError>) -> Str
    match r
        Ok(v)  => "${v}"
        Err(e) => "err " + formerr.error_field(e)

fn float_of(r: Result<Float, formerr.FormError>) -> Str
    match r
        Ok(v)  => "${v}"
        Err(e) => "err " + formerr.error_field(e)

fn str_of(r: Result<Str, formerr.FormError>) -> Str
    match r
        Ok(v)  => v
        Err(e) => "err " + formerr.error_field(e)

@test
fn test_every_refusal_names_the_field() [io]
    let b = parsed("age=old&name=ada")

    test.case("a field that does not parse names itself and quotes what arrived")
    match formfield.get_int(b, "age")
        Ok(_)  => test.assert(false)
        Err(e) =>
            test.assert(formerr.error_field(e) == "age")
            test.assert(str.contains(formerr.messages([e]), "age"))
            test.assert(str.contains(formerr.messages([e]), "old"))

    test.case("a missing field names itself too")
    match formfield.get_str(b, "city")
        Ok(_)  => test.assert(false)
        Err(e) =>
            test.assert(formerr.error_field(e) == "city")
            test.assert(not formerr.is_limit(e))

    test.case("and a field that is there comes back")
    match formfield.get_str(b, "name")
        Err(_) => test.assert(false)
        Ok(v)  => test.assert(v == "ada")

@test
fn test_an_integer_is_decimal_and_nothing_else() [io]
    let b = parsed("a=42&b=-7&c=0x10&d=+3&e=&f=4.5")

    test.case("decimal, with an optional sign")
    test.assert(int_of(formfield.get_int(b, "a")) == "42")
    test.assert(int_of(formfield.get_int(b, "b")) == "-7")

    test.case("hexadecimal is not an integer: no browser sends one")
    match formfield.get_int(b, "c")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("and neither is an empty value or a decimal point")
    match formfield.get_int(b, "e")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match formfield.get_int(b, "f")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_out_of_range_is_a_different_sentence_from_not_a_number() [io]
    let b = parsed("age=200&other=old")

    test.case("a number outside its bounds carries both bounds")
    match formfield.get_int_between(b, "age", 1, 120)
        Ok(_)  => test.assert(false)
        Err(e) =>
            test.assert(formerr.error_field(e) == "age")
            test.assert(str.contains(formerr.messages([e]), "120"))

    test.case("and a number inside them comes back")
    test.assert(int_of(formfield.get_int_between(b, "age", 1, 1000)) == "200")

    test.case("a value that is not a number at all is the OTHER refusal")
    match formfield.get_int_between(b, "other", 1, 120)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(formerr.messages([e]), "old"))

@test
fn test_a_booleans_spellings_are_the_webs() [io]
    let b = parsed("a=on&c=true&d=yes&e=1&f=off&g=false&h=no&i=0&j=&k=maybe")

    test.case("what a ticked checkbox actually sends")
    test.assert(bool_of(formfield.get_bool(b, "a")) == "true")

    test.case("and the three other truthy spellings")
    test.assert(bool_of(formfield.get_bool(b, "c")) == "true")
    test.assert(bool_of(formfield.get_bool(b, "d")) == "true")
    test.assert(bool_of(formfield.get_bool(b, "e")) == "true")

    test.case("the falsy ones, including the empty value")
    test.assert(bool_of(formfield.get_bool(b, "f")) == "false")
    test.assert(bool_of(formfield.get_bool(b, "g")) == "false")
    test.assert(bool_of(formfield.get_bool(b, "h")) == "false")
    test.assert(bool_of(formfield.get_bool(b, "i")) == "false")
    test.assert(bool_of(formfield.get_bool(b, "j")) == "false")

    test.case("anything else is a refusal that quotes what arrived")
    match formfield.get_bool(b, "k")
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(formerr.messages([e]), "maybe"))

@test
fn test_absence_means_false_only_in_the_call_named_checkbox() [io]
    let b = parsed("ticked=on")

    test.case("an absent field is missing, not false")
    match formfield.get_bool(b, "unticked")
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(formerr.error_field(e) == "unticked")

    test.case("and `checkbox` is the one call where absence is an answer")
    test.assert(formfield.checkbox(b, "ticked"))
    test.assert(not formfield.checkbox(b, "unticked"))

@test
fn test_a_repeated_key_is_the_only_list_a_form_has() [io]
    let b = parsed("tag=a&tag=b&tag=c&n=1&n=2&n=x")

    test.case("every value, in order")
    let tags = formfield.get_list(b, "tag")
    test.assert(list.len(tags) == 3)
    test.assert(tags[2] == "c")

    test.case("an absent name is an empty list")
    test.assert(list.len(formfield.get_list(b, "absent")) == 0)

    test.case("and a required list says so")
    match formfield.get_list_required(b, "absent")
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(formerr.error_field(e) == "absent")

    test.case("one bad element refuses the whole list, naming the value")
    match formfield.get_int_list(b, "n")
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(formerr.messages([e]), "x"))

@test
fn test_a_float_is_what_a_number_input_sends() [io]
    let b = parsed("a=1.5&b=-2e3&c=NaN&d=Infinity")

    test.case("a decimal and an exponent")
    test.assert(float_of(formfield.get_float(b, "a")) == "1.5")
    test.assert(float_of(formfield.get_float(b, "b")) == "-2000")

    test.case("NaN and Infinity are refused")
    match formfield.get_float(b, "c")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match formfield.get_float(b, "d")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_the_bounded_and_defaulted_reads() [io]
    let b = parsed("name=ada&empty=&long=abcdefghij")

    test.case("a default covers absent AND empty — an untouched text input sends empty")
    test.assert(formfield.get_or(b, "name", "anon") == "ada")
    test.assert(formfield.get_or(b, "empty", "anon") == "anon")
    test.assert(formfield.get_or(b, "absent", "anon") == "anon")

    test.case("a length bound is in BYTES, which is what a column is measured in")
    match formfield.get_str_bounded(b, "long", 4)
        Ok(_)  => test.assert(false)
        Err(e) =>
            test.assert(formerr.error_field(e) == "long")
            test.assert(str.contains(formerr.messages([e]), "4"))

    test.case("and a value inside it comes back")
    test.assert(str_of(formfield.get_str_bounded(b, "name", 8)) == "ada")

@test
fn test_a_select_is_checked_against_what_the_server_offered() [io]
    let b = parsed("colour=green&other=purple")

    test.case("an offered option comes back")
    test.assert(str_of(formfield.get_one_of(b, "colour", ["red", "green", "blue"])) == "green")

    test.case("anything else is refused, quoting what was tried")
    match formfield.get_one_of(b, "other", ["red", "green", "blue"])
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(str.contains(formerr.messages([e]), "purple"))

@test
fn test_check_answers_every_bad_field_and_not_the_first() [io]
    let b = parsed("age=old&count=none&flag=maybe&colour=purple")
    let expects = [formfield.expect_int("age"),
                   formfield.expect_int("count"),
                   formfield.expect_bool("flag"),
                   formfield.expect_str("name"),
                   formfield.expect_int_between("size", 1, 10),
                   formfield.expect_str("city")]

    test.case("six expectations, six findings")
    let bad = formfield.check(b, expects)
    test.assert(list.len(bad) == 6)

    test.case("and every one of them names its field")
    for e in bad
        test.assert(formerr.error_field(e) != "")

    test.case("which is what makes the 400's body a thing a person can act on")
    test.assert(str.contains(formerr.messages(bad), "age"))
    test.assert(str.contains(formerr.messages(bad), "city"))

    test.case("so the form is not valid")
    test.assert(not formfield.is_valid(b, expects))

    test.case("an optional expectation is not a finding when the field is absent")
    test.assert(formfield.is_valid(parsed("a=1"),
                                   [formfield.expect_int("a"),
                                    formfield.optional(formfield.expect_str("b"))]))

    test.case("and none of these are limit refusals, so the status is 400")
    test.assert(not formerr.any_limit(bad))
    test.assert(formerr.status_for(bad[0]) == 400)

@test
fn test_unexpected_keys_are_reported_and_not_refused() [io]
    let b = parsed("name=ada&csrf=abc&submit=Save")
    let expects = [formfield.expect_str("name")]

    test.case("a form legitimately carries a token and a submit button")
    let extra = formfield.unexpected_keys(b, expects)
    test.assert(list.len(extra) == 2)

    test.case("and it is still valid, because they are not failures")
    test.assert(formfield.is_valid(b, expects))

@test
fn test_the_bracket_convention_is_reported_rather_than_parsed() [io]
    let b = parsed("tag[]=a&tag[]=b&user[name]=ada&plain=x")

    test.case("the bracketed names are reported")
    let names = formfield.bracket_names(b)
    test.assert(list.len(names) == 2)

    test.case("the base name is published for a caller that decided to strip")
    test.assert(formfield.bracket_base("tag[]") == "tag")
    test.assert(formfield.bracket_base("user[name]") == "user")

    test.case("and a plain key is its own base")
    test.assert(formfield.bracket_base("plain") == "plain")

    test.case("a body that uses none costs nothing")
    test.assert(list.len(formfield.bracket_names(parsed("a=1&b=2"))) == 0)

@test
fn test_the_expectations_are_values_a_handler_writes_beside_its_route() [io]
    test.case("each of the four constructors sets its kind")
    test.assert(formfield.expect_str("a").kind == FormKindStr)
    test.assert(formfield.expect_int("a").kind == FormKindInt)
    test.assert(formfield.expect_bool("a").kind == FormKindBool)
    test.assert(formfield.expect_int_between("a", 1, 9).kind == FormKindInt)

    test.case("and each of them is required until it is not")
    test.assert(formfield.expect_str("a").required)
    test.assert(not formfield.optional(formfield.expect_str("a")).required)

    test.case("a bounded expectation carries its bounds")
    let e = formfield.expect_int_between("a", 1, 9)
    test.assert(e.min == 1)
    test.assert(e.max == 9)

    test.case("and an unbounded one says so by having none that hold")
    test.assert(formfield.expect_int("a").min > formfield.expect_int("a").max)

@test
fn test_the_number_grammars() [io]
    let b = parsed("p=%2B3&big=99999999999999999999&h=.5&t=1.&e=1e%2B5&n=1e&dot=.&s=-")

    test.case("a leading plus sign is read")
    test.assert(int_of(formfield.get_int(b, "p")) == "3")

    test.case("an integer too large for an Int is refused")
    test.assert(int_of(formfield.get_int(b, "big")) == "err big")
    test.assert(int_of(formfield.get_int(b, "s")) == "err s")

    test.case("a number may start or end with its point, and its exponent may be signed")
    test.assert(float_of(formfield.get_float(b, "h")) == "0.5")
    test.assert(float_of(formfield.get_float(b, "t")) == "1")
    test.assert(float_of(formfield.get_float(b, "e")) == "100000")

    test.case("an exponent with no digits, and a point alone, are refused")
    test.assert(float_of(formfield.get_float(b, "n")) == "err n")
    test.assert(float_of(formfield.get_float(b, "dot")) == "err dot")

@test
fn test_lists_that_succeed() [io]
    let b = parsed("n=1&n=2&t=a")

    test.case("a required list with values, and a list of integers")
    match formfield.get_list_required(b, "t")
        Ok(vs) => test.assert(list.len(vs) == 1)
        Err(_) => test.assert(false)
    match formfield.get_int_list(b, "n")
        Ok(ns) => test.assert(ns[1] == 2)
        Err(_) => test.assert(false)

@test
fn test_check_reads_every_kind() [io]
    let b = parsed("s=abcdef&i=5&t=on&f=1.5&g=x&l=1")
    let short = FormExpect { name: "s", kind: FormKindStr, required: true, min: 1, max: 0, max_len: 3 }
    let wide = FormExpect { name: "s", kind: FormKindStr, required: true, min: 1, max: 0, max_len: 10 }
    let num = FormExpect { name: "f", kind: FormKindFloat, required: true, min: 1, max: 0, max_len: 0 - 1 }
    let bad = FormExpect { name: "g", kind: FormKindFloat, required: true, min: 1, max: 0, max_len: 0 - 1 }
    let lst = FormExpect { name: "l", kind: FormKindList, required: true, min: 1, max: 0, max_len: 0 - 1 }

    test.case("a string over its length, and a number that is not one, are findings")
    let found = formfield.check(b, [short, num, bad])
    test.assert(list.len(found) == 2)
    match found[0]
        FormTooLong(n, len, lim) =>
            test.assert(n == "s")
            test.assert(len == 6)
            test.assert(lim == 3)
        _                        => test.assert(false)

    test.case("every kind that reads is not a finding")
    test.assert(formfield.is_valid(b, [wide, num, lst, formfield.expect_bool("t"),
                                       formfield.expect_int_between("i", 1, 9)]))

    test.case("an integer outside its bounds is a finding")
    test.assert(not formfield.is_valid(b, [formfield.expect_int_between("i", 6, 9)]))
