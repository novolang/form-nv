// formscan.nv — the `application/x-www-form-urlencoded` walk, as
// `@value` state.
//
// A scan is four integers that a caller feeds an encoded body one byte
// at a time.  It holds no buffer and allocates nothing, so a
// microcontroller can read `ssid=home&psk=hunter2&chan=6` into fixed
// buffers of its own.  `formurl.parse` is the same walk fed from a
// `Bytes`, with the spans collected, so the host answer and the device
// answer come from one piece of code.
//
// The rules are the WHATWG URL Standard's
// `application/x-www-form-urlencoded` parser (section 5.1).  `&`
// separates fields.  The first `=` in a field separates its name from
// its value, and a field with no `=` is a name with an empty value.  An
// empty field is skipped.  `+` decodes to a space, and `%` followed by
// two hexadecimal digits decodes to the byte they spell.  A `%` that is
// not followed by two hexadecimal digits is kept as it is.
//
// Decoding happens on the step that settles a byte.  A plain byte and a
// `+` settle at once.  An escape settles on its second digit.  A `%`
// that turns out not to begin an escape settles on the byte that shows
// it, and that step produces the `%`, the digit before it if there was
// one, and the byte itself: up to three decoded bytes from one step.
// `scan_out_count` and `scan_out_at` read them, and `scan_out` is the
// first.
//
// A `@value` struct holds scalars only (SPEC section 14.2), and a
// refusal has no `Result` to travel in, so a `%` that begins no escape
// is a flag on the scan, `scan_bad_escape`, rather than an error.
//
// Every function here carries `@tier(embedded)`.

// The layout of `FormScan.flags`: the three decoded bytes of a step and
// their count, the step's events, then the state that lasts from step
// to step.
const OUT_SHIFT: Int = 0
const COUNT_SHIFT: Int = 24
const KEY_DONE: Int = 26
const FIELD_DONE: Int = 27
const OUT_IN_KEY: Int = 28
const STAGE_SHIFT: Int = 29
const DIGIT_SHIFT: Int = 32
const BAD: Int = 40
const HAS_VALUE: Int = 41
const OPEN: Int = 42

// The pair separator, `&`.
pub @tier(embedded)
fn separator() -> Int []
    '&'

// The separator between a name and its value, `=`.
pub @tier(embedded)
fn assigner() -> Int []
    '='

// The byte `+` decodes to: a space.
pub @tier(embedded)
fn plus_means() -> Int []
    ' '

// A body walk in progress.
//
// Every field is an integer, and the struct lives in the caller's stack
// frame.  A caller reads it through the functions below rather than
// through `flags`, whose bit positions are this module's.
pub @value
struct FormScan
    // The offset of the next byte to feed, in the encoded body.
    pos: Int
    // The offset where the current field begins: one past the `&` that
    // opened it.
    field_start: Int
    // How many non-empty fields have closed.
    field_index: Int
    // The decoded bytes of the last step, what that step ended, and
    // the state of the current field and escape.
    flags: Int

// A fresh scan, before any byte.
//
// ```novo
// use formscan
//
// fn main() [io]
//     println("${formscan.scan_pos(formscan.scan())}")
// ```
pub @tier(embedded)
fn scan() -> FormScan []
    FormScan { pos: 0, field_start: 0, field_index: 0, flags: 0 }

// Feed one encoded byte and answer the scan after it.
pub @tier(embedded)
fn scan_byte(s: FormScan, byte: Int) -> FormScan []
    let keep = s.flags & sticky_mask()
    let stage = (keep >> STAGE_SHIFT) & 3
    let digit = (keep >> DIGIT_SHIFT) & 255
    let st = FormScan { pos: s.pos + 1, field_start: s.field_start,
                        field_index: s.field_index,
                        flags: keep & escape_cleared() }
    if stage == 1
        if hex_value(byte) >= 0
            return FormScan { pos: st.pos, field_start: st.field_start,
                              field_index: st.field_index,
                              flags: st.flags | (2 << STAGE_SHIFT) | (byte << DIGIT_SHIFT) }
        return plain(set_bit(st, BAD), byte, '%', 1)
    if stage == 2
        let lo = hex_value(byte)
        if lo >= 0
            return with_outs(st, hex_value(digit) * 16 + lo, 1, in_key(st))
        return plain(set_bit(st, BAD), byte, '%' | (digit << 8), 2)
    plain(st, byte, 0, 0)

// Tell the scan the body has ended.
//
// A `%`, or a `%` and one digit, left open is kept as it is and sets
// `scan_bad_escape`, and the open field closes.
pub @tier(embedded)
fn scan_end(s: FormScan) -> FormScan []
    let keep = s.flags & sticky_mask()
    let stage = (keep >> STAGE_SHIFT) & 3
    let digit = (keep >> DIGIT_SHIFT) & 255
    let st = FormScan { pos: s.pos, field_start: s.field_start,
                        field_index: s.field_index,
                        flags: keep & escape_cleared() }
    if stage == 1
        return close(set_bit(st, BAD), '%', 1)
    if stage == 2
        return close(set_bit(st, BAD), '%' | (digit << 8), 2)
    close(st, 0, 0)

// ── What a step produced ─────────────────────────────────────────────

// Whether the last step produced a decoded byte.
//
// False for a `%`, for the first digit after one, for `=` and for `&`.
pub @tier(embedded)
fn scan_emitted(s: FormScan) -> Bool []
    scan_out_count(s) > 0

// The first decoded byte the last step produced, or -1 when it produced
// none.
//
// `+` answers 32.  `%2F` answers 47, on the step that fed the `F`.
pub @tier(embedded)
fn scan_out(s: FormScan) -> Int []
    scan_out_at(s, 0)

// How many decoded bytes the last step produced: 0 to 3.
pub @tier(embedded)
fn scan_out_count(s: FormScan) -> Int []
    (s.flags >> COUNT_SHIFT) & 3

// The decoded byte at index `i` of the last step's output, or -1 when
// the step produced fewer.
pub @tier(embedded)
fn scan_out_at(s: FormScan, i: Int) -> Int []
    if i < 0 or i >= scan_out_count(s)
        return 0 - 1
    (s.flags >> (OUT_SHIFT + 8 * i)) & 255

// Whether the last step's decoded bytes belong to the current field's
// name rather than to its value.
pub @tier(embedded)
fn scan_in_key(s: FormScan) -> Bool []
    has(s.flags, OUT_IN_KEY)

// Whether the byte just fed was the `=` that ends the name.
pub @tier(embedded)
fn scan_key_done(s: FormScan) -> Bool []
    has(s.flags, KEY_DONE)

// Whether the last step closed a non-empty field: it fed the `&` after
// one, or it was the `scan_end` after one.
pub @tier(embedded)
fn scan_field_done(s: FormScan) -> Bool []
    has(s.flags, FIELD_DONE)

// ── Reading the scan ─────────────────────────────────────────────────

// The offset of the next byte to feed.
pub @tier(embedded)
fn scan_pos(s: FormScan) -> Int []
    s.pos

// Where the current field starts, in the encoded body.
pub @tier(embedded)
fn scan_field_start(s: FormScan) -> Int []
    s.field_start

// How many non-empty fields have closed.
pub @tier(embedded)
fn scan_fields(s: FormScan) -> Int []
    s.field_index

// Whether the current field has seen its `=`.
pub @tier(embedded)
fn scan_has_value(s: FormScan) -> Bool []
    has(s.flags, HAS_VALUE)

// Whether the scan is part-way through a `%XX` escape: after a `%`, and
// after its first digit.
pub @tier(embedded)
fn scan_in_escape(s: FormScan) -> Bool []
    ((s.flags >> STAGE_SHIFT) & 3) != 0

// Whether the scan has seen a `%` that began no escape, anywhere in the
// body.
//
// The standard keeps such a `%` as a literal byte, and so does the scan.
// This flag is how a caller that wants to be stricter finds out.
pub @tier(embedded)
fn scan_bad_escape(s: FormScan) -> Bool []
    has(s.flags, BAD)

// ── The byte arithmetic ──────────────────────────────────────────────

// The value of a hexadecimal digit, either case, or -1 when the byte is
// not one.
pub @tier(embedded)
fn hex_value(byte: Int) -> Int []
    if byte >= '0' and byte <= '9'
        return byte - '0'
    if byte >= 'A' and byte <= 'F'
        return byte - 'A' + 10
    if byte >= 'a' and byte <= 'f'
        return byte - 'a' + 10
    0 - 1

// The upper-case hexadecimal digit for a value from 0 to 15.
//
// The serialiser of the WHATWG URL Standard writes upper case.
pub @tier(embedded)
fn hex_digit(value: Int) -> Int []
    if value < 10
        return '0' + value
    'A' + value - 10

// Whether a byte is written as itself by the WHATWG serialiser: an
// ASCII letter or digit, `*`, `-`, `.` or `_`.
//
// `~` is not in the set, where Python's `urllib.parse.quote_plus` leaves
// it alone.
pub @tier(embedded)
fn byte_safe(byte: Int) -> Bool []
    byte >= 'a' and byte <= 'z' or byte >= 'A' and byte <= 'Z' or byte >= '0' and byte <= '9' or byte == '*' or byte == '-' or byte == '.' or byte == '_'

// How many bytes one byte serialises to: 1 for a safe byte and for a
// space, which becomes `+`, and 3 for any other.
pub @tier(embedded)
fn encoded_len(byte: Int) -> Int []
    if byte_safe(byte) or byte == ' '
        return 1
    3

// ── The walk ─────────────────────────────────────────────────────────

// The bits that last from one step to the next.
@tier(embedded)
fn sticky_mask() -> Int
    (3 << STAGE_SHIFT) | (255 << DIGIT_SHIFT) | (1 << BAD) | (1 << HAS_VALUE) | (1 << OPEN)

// Every bit but the escape stage and its digit.
@tier(embedded)
fn escape_cleared() -> Int
    0 - 1 - (3 << STAGE_SHIFT) - (255 << DIGIT_SHIFT)

// Whether bit `n` of `flags` is set.
@tier(embedded)
fn has(flags: Int, n: Int) -> Bool
    ((flags >> n) & 1) == 1

// The scan with bit `n` set.
@tier(embedded)
fn set_bit(s: FormScan, n: Int) -> FormScan
    FormScan { pos: s.pos, field_start: s.field_start, field_index: s.field_index,
               flags: s.flags | (1 << n) }

// Whether the next decoded byte belongs to the name.
@tier(embedded)
fn in_key(s: FormScan) -> Bool
    not has(s.flags, HAS_VALUE)

// The scan with `n` decoded bytes, packed a byte each into `outs`, as
// the step's output, belonging to the name or to the value.  The field
// is then open.
@tier(embedded)
fn with_outs(s: FormScan, outs: Int, n: Int, key: Bool) -> FormScan
    var f = s.flags | (outs << OUT_SHIFT) | (n << COUNT_SHIFT) | (1 << OPEN)
    if key
        f = f | (1 << OUT_IN_KEY)
    FormScan { pos: s.pos, field_start: s.field_start, field_index: s.field_index, flags: f }

// One byte outside an escape, after `n` bytes `prior` that a `%` which
// began no escape left to be written first.
@tier(embedded)
fn plain(s: FormScan, byte: Int, prior: Int, n: Int) -> FormScan
    let key = in_key(s)
    if byte == '&'
        return close(s, prior, n)
    if byte == '=' and key
        let named = with_outs(s, prior, n, true)
        return set_bit(set_bit(named, KEY_DONE), HAS_VALUE)
    if byte == '%'
        let opened = with_outs(s, prior, n, key)
        return FormScan { pos: opened.pos, field_start: opened.field_start,
                          field_index: opened.field_index,
                          flags: opened.flags | (1 << STAGE_SHIFT) }
    var b = byte
    if byte == '+'
        b = ' '
    with_outs(s, prior | (b << (8 * n)), n + 1, key)

// The field closed at the scan's position, after `n` bytes `prior` of
// output that belong to it.  An empty field closes without counting.
@tier(embedded)
fn close(s: FormScan, prior: Int, n: Int) -> FormScan
    let key = in_key(s)
    let was_open = has(s.flags, OPEN) or n > 0
    var f = s.flags & (0 - 1 - (1 << HAS_VALUE) - (1 << OPEN))
    f = f | (prior << OUT_SHIFT) | (n << COUNT_SHIFT)
    if key and n > 0
        f = f | (1 << OUT_IN_KEY)
    var count = s.field_index
    if was_open
        count = count + 1
        f = f | (1 << FIELD_DONE)
    FormScan { pos: s.pos, field_start: s.pos, field_index: count, flags: f }
