// formerr.nv — every refusal, and the field it is about.
//
// A refusal is one of three kinds, and each goes to a different place.
//
// A parse refusal is about a malformed request: a `Content-Type` that
// is not `multipart/form-data`, a part with no name, a body that ends
// before its closing boundary.
//
// A limit refusal is about a request larger than the endpoint accepts:
// a part, a body, a header section or a name past its bound, or too
// many parts or fields.  `status_for` answers 413 for these.
//
// A field refusal is about a value a person typed: a required field
// that is missing, a number that does not parse, a value outside its
// range.  Each carries the field's name, so the 400 a handler answers
// can say which field and what was expected.

use std.list
use std.str

// What went wrong.
pub enum FormError
    // ── The parse ────────────────────────────────────────────────────
    // A `Content-Type` that is not `multipart/form-data`.
    FormNotMultipart(found: Str)
    // A `multipart/form-data` header with no `boundary` parameter, or
    // one RFC 2046 section 5.1.1 does not admit.
    FormNoBoundary(header: Str)
    // A part whose `Content-Disposition` carries no `name` parameter,
    // which RFC 7578 section 4.2 requires.
    FormNoFieldName(part_index: Int)
    // A part with no `Content-Disposition: form-data` header.
    FormNoDisposition(part_index: Int)
    // A line in a part's header section that is not `Name: value`, or
    // bytes after a boundary that are neither `--` nor a line break.
    // `at` is the byte offset in the body.
    FormBadHeader(part_index: Int, at: Int)
    // The stream ended before the closing boundary.  `at` is the number
    // of bytes fed.
    FormTruncated(part_index: Int, at: Int)

    // ── The limits, each refused at the byte the bound was crossed ───
    // One part's body passed `max_part_bytes`.  `name` is the part's
    // field name.
    FormPartTooLarge(part_index: Int, name: Str, limit: Int)
    // The whole body passed `max_total_bytes`.
    FormBodyTooLarge(limit: Int)
    // More parts than `max_parts`.
    FormTooManyParts(limit: Int)
    // One part's header section passed `max_headers_bytes`.
    FormHeadersTooLarge(part_index: Int, limit: Int)
    // More header fields in one part than `max_headers`.
    FormTooManyHeaders(part_index: Int, limit: Int)
    // A field name longer than `max_name_bytes`.
    FormNameTooLong(part_index: Int, limit: Int)
    // An urlencoded body with more fields than `parse_bounded` allows.
    FormTooManyPairs(limit: Int)

    // ── The fields, each carrying the field's name ───────────────────
    // A required field the body does not carry.
    FormMissing(name: Str)
    // A field that does not read as an integer, and the text that
    // arrived.
    FormNotAnInt(name: Str, text: Str)
    // A field that does not read as a number.
    FormNotAFloat(name: Str, text: Str)
    // A field that is not one of the boolean spellings `get_bool`
    // reads.
    FormNotABool(name: Str, text: Str)
    // An integer outside its inclusive bounds.
    FormOutOfRange(name: Str, text: Str, min: Int, max: Int)
    // A string longer than the field allows, in bytes.
    FormTooLong(name: Str, length: Int, limit: Int)
    // A value outside the set the field offers.
    FormNotAllowed(name: Str, text: Str)
    // A required list with no values.
    FormEmptyList(name: Str)

// The standard `Error` implementation, so a refusal is reported by
// anything that reports errors.
impl Error for FormError
    // One line.  A field refusal names the field and says what was
    // expected; a limit refusal names the limit.
    fn message(self) -> Str
        match self
            FormNotMultipart(t)          => "the body is `${t}`, not multipart/form-data"
            FormNoBoundary(h)            => "`${h}` names no multipart boundary"
            FormNoFieldName(i)           => "part ${i} has no field name"
            FormNoDisposition(i)         => "part ${i} has no Content-Disposition: form-data header"
            FormBadHeader(i, at)         => "part ${i}: at byte ${at}, a header line is not `Name: value`"
            FormTruncated(i, at)         => "the body ended after ${at} bytes, in part ${i}, before its closing boundary"
            FormPartTooLarge(i, n, lim)  => "part ${i} (${n}) is larger than ${lim} bytes"
            FormBodyTooLarge(lim)        => "the body is larger than ${lim} bytes"
            FormTooManyParts(lim)        => "the body has more than ${lim} parts"
            FormHeadersTooLarge(i, lim)  => "part ${i}'s headers are larger than ${lim} bytes"
            FormTooManyHeaders(i, lim)   => "part ${i} has more than ${lim} header fields"
            FormNameTooLong(i, lim)      => "part ${i}'s field name is longer than ${lim} bytes"
            FormTooManyPairs(lim)        => "the form has more than ${lim} fields"
            FormMissing(n)               => "${n} is required"
            FormNotAnInt(n, t)           => "${n} must be a whole number, and `${t}` is not one"
            FormNotAFloat(n, t)          => "${n} must be a number, and `${t}` is not one"
            FormNotABool(n, t)           => "${n} must be yes or no, and `${t}` is neither"
            FormOutOfRange(n, t, lo, hi) => "${n} must be between ${lo} and ${hi}, and `${t}` is not"
            FormTooLong(n, len, lim)     => "${n} must be at most ${lim} bytes, and it is ${len}"
            FormNotAllowed(n, t)         => "${n} cannot be `${t}`"
            FormEmptyList(n)             => "${n} needs at least one value"

// The field a refusal is about, or the empty string for one about the
// request.
//
// A part too large names its part's field, since that is the input a
// person chose.
pub fn error_field(e: FormError) -> Str []
    match e
        FormPartTooLarge(_, n, _)  => n
        FormMissing(n)             => n
        FormNotAnInt(n, _)         => n
        FormNotAFloat(n, _)        => n
        FormNotABool(n, _)         => n
        FormOutOfRange(n, _, _, _) => n
        FormTooLong(n, _, _)       => n
        FormNotAllowed(n, _)       => n
        FormEmptyList(n)           => n
        _                          => ""

// Whether a refusal is about a limit rather than about the parse or a
// field.
pub fn is_limit(e: FormError) -> Bool []
    match e
        FormPartTooLarge(_, _, _) => true
        FormBodyTooLarge(_)       => true
        FormTooManyParts(_)       => true
        FormHeadersTooLarge(_, _) => true
        FormTooManyHeaders(_, _)  => true
        FormNameTooLong(_, _)     => true
        FormTooManyPairs(_)       => true
        _                         => false

// The HTTP status a refusal should produce: 413 for a limit, 415 for a
// content type that is not multipart, and 400 for everything else.
//
// A 500 for a bad field would tell a client to retry a request that
// will never succeed.
//
// ```novo
// use formerr
//
// fn main() [io]
//     println("${formerr.status_for(FormMissing("name"))}")
// ```
pub fn status_for(e: FormError) -> Int []
    if is_limit(e)
        return 413
    match e
        FormNotMultipart(_) => 415
        _                   => 400

// The byte offset in the body a parse refusal refers to, or -1.
//
// `FormBadHeader` and `FormTruncated` have one.  Every other refusal is
// about a header value, a limit or a value the caller already holds.
pub fn error_at(e: FormError) -> Int []
    match e
        FormBadHeader(_, at) => at
        FormTruncated(_, at) => at
        _                    => 0 - 1

// Every refusal's message, one per line, in the order given.
pub fn messages(es: [FormError]) -> Str []
    var lines: [Str] = []
    for e in es
        list.push(lines, e.message())
    str.join(lines, "\n")

// Whether any refusal in a list is about a limit.
pub fn any_limit(es: [FormError]) -> Bool []
    for e in es
        if is_limit(e)
            return true
    false
